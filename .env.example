# Redfox AI Environment Configuration Example
APP_ENV=development
LAB_TARGET=http://juice-shop:3000
DATABASE_URL=sqlite:///./redfox_ai.db

# Local Ollama AI Reasoning Engine
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
LLM_TIMEOUT_SECONDS=30.0

# Security tool constraints
TOOL_TIMEOUT_SECONDS=5.0
MAX_RESPONSE_BYTES=524288
